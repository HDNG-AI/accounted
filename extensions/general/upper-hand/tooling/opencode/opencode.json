{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "staik": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Staik-Mini-Harness",
      "options": {
        "baseURL": "https://api.staik.se/v1",
        "apiKey": "{env:STAIK_API_KEY}"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen 3.6 35B-A3B",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "gemma4:31b": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "hdng-auto": {
          "name": "Staik auto (routes to qwen3.6)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "qwen3.6:35b-a3b",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "HANDOFF.md": "deny",
      "docs/agent-learning/retros/**": "deny",
      "docs/agent-learning/dogfooding.md": "deny",
      "docs/agent-learning/sessioner.md": "deny",
      "docs/agent-learning/beslut.md": "deny"
    },
    "write": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "HANDOFF.md": "deny"
    },
    "bash": {
      "*": "ask",
      "pnpm test*": "allow",
      "pnpm typecheck": "allow",
      "pnpm lint": "allow",
      "pnpm agent *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "cat .env*": "deny",
      "cat ../*": "deny",
      "cat /*": "deny",
      "curl *": "deny",
      "wget *": "deny"
    },
    "webfetch": "deny"
  }
}
