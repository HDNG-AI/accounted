# Accounted MCP, read-only key. Never a key with write or approve scopes.
ACCOUNTED_API_KEY=
# ACCOUNTED_MCP_URL=http://<host>:3001/api/extensions/ext/mcp-server/mcp?tool_namespace=accounted

# Model access, by route class (see scripts/model_client.py). Defaults are the hackathon setup: Staik, qwen3.6 for
# analysis, gemma4 for control. When the HDNG Core model gateway exists, point HDNG_MODEL_GATEWAY_URL at it and
# use the AppExecutionGrant as HDNG_APP_TOKEN; the customer's instance policy then decides the models.
STAIK_API_KEY=
# HDNG_MODEL_GATEWAY_URL=https://api.staik.se/v1
# HDNG_APP_TOKEN=
# HDNG_PROVIDER_LABEL=Staik · SE
# HDNG_ROUTE_ANALYSIS=qwen3.6:35b-a3b
# HDNG_ROUTE_CONTROL=gemma4:31b
